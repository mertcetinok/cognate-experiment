        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="if ((btn_yes.numClicks &gt; 0)) {&amp;#10;    lex_resp = 1;&amp;#10;} else {&amp;#10;    lex_resp = 0;&amp;#10;}&amp;#10;if ((lex_resp === Number.parseInt(is_word))) {&amp;#10;    lex_corr = 1;&amp;#10;} else {&amp;#10;    lex_corr = 0;&amp;#10;}&amp;#10;if (((Number.parseInt(dummy) === 0) &amp;&amp; (lex_corr === 1))) {&amp;#10;    if ((Number.parseInt(is_word) === 1)) {&amp;#10;        lex_word_corr = (lex_word_corr + 1);&amp;#10;    } else {&amp;#10;        lex_nonword_corr = (lex_nonword_corr + 1);&amp;#10;    }&amp;#10;}&amp;#10;lextale_score = ((((lex_word_corr / 40) * 100) + ((lex_nonword_corr / 20) * 100)) / 2);&amp;#10;psychoJS.experiment.addData(&quot;lex_resp&quot;, lex_resp);&amp;#10;psychoJS.experiment.addData(&quot;lex_corr&quot;, lex_corr);&amp;#10;psychoJS.experiment.addData(&quot;lextale_score&quot;, lextale_score);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="if btn_yes.numClicks &gt; 0:&amp;#10;    lex_resp = 1&amp;#10;else:&amp;#10;    lex_resp = 0&amp;#10;if lex_resp == int(is_word):&amp;#10;    lex_corr = 1&amp;#10;else:&amp;#10;    lex_corr = 0&amp;#10;if int(dummy) == 0 and lex_corr == 1:&amp;#10;    if int(is_word) == 1:&amp;#10;        lex_word_corr = lex_word_corr + 1&amp;#10;    else:&amp;#10;        lex_nonword_corr = lex_nonword_corr + 1&amp;#10;lextale_score = (lex_word_corr / 40 * 100 + lex_nonword_corr / 20 * 100) / 2&amp;#10;thisExp.addData('lex_resp', lex_resp)&amp;#10;thisExp.addData('lex_corr', lex_corr)&amp;#10;thisExp.addData('lextale_score', lextale_score)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="lex_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
