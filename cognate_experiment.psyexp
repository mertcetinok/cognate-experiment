      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[OrderedDict([('item', 'PR1'), ('condition', 'PRACTICE'), ('pair', None), ('critical', 'Cheese'), ('sentence', 'She sliced the cheese with a sharp'), ('audio', 'audio/prac_cheese.wav'), ('target', 'images/knife.png'), ('d1', 'images/kite.png'), ('d2', 'images/drum.png'), ('d3', 'images/wallet.png'), ('competitor_slot', None), ('audio_dur', np.float64(2.135))]), OrderedDict([('item', 'PR2'), ('condition', 'PRACTICE'), ('pair', None), ('critical', 'Door'), ('sentence', 'He locked the door with his'), ('audio', 'audio/prac_door.wav'), ('target', 'images/key.png'), ('d1', 'images/tiger.png'), ('d2', 'images/lemon.png'), ('d3', 'images/rainbow.png'), ('competitor_slot', None), ('audio_dur', np.float64(1.548))]), OrderedDict([('item', 'PR3'), ('condition', 'PRACTICE'), ('pair', None), ('critical', 'Letter'), ('sentence', 'She wrote the letter with a blue'), ('audio', 'audio/prac_letter.wav'), ('target', 'images/pen.png'), ('d1', 'images/giraffe.png'), ('d2', 'images/pumpkin.png'), ('d3', 'images/mushroom.png'), ('competitor_slot', None), ('audio_dur', np.float64(1.454))]), OrderedDict([('item', 'PR4'), ('condition', 'PRACTICE'), ('pair', None), ('critical', 'Paper'), ('sentence', 'She cut the paper with the'), ('audio', 'audio/prac_paper.wav'), ('target', 'images/scissors.png'), ('d1', 'images/snake.png'), ('d2', 'images/zebra.png'), ('d3', 'images/trumpet.png'), ('competitor_slot', None), ('audio_dur', np.float64(1.42))])]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="practice.csv" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="code"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="code"/>
      <Param name="name" updates="None" val="practice_loop" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="trial"/>
    <LoopTerminator name="practice_loop"/>
    <Routine name="practice_end"/>
