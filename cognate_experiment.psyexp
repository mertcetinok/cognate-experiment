      </TextComponent>
      <CodeComponent name="pos_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="labels = []&amp;#10;for i in range(24):&amp;#10;    labels.append('TC')&amp;#10;for i in range(24):&amp;#10;    labels.append('NC')&amp;#10;for i in range(24):&amp;#10;    labels.append('FC')&amp;#10;&amp;#10;idx = []&amp;#10;for i in range(72):&amp;#10;    idx.append(i)&amp;#10;&amp;#10;for attempt in range(1000):&amp;#10;    shuffle(idx)&amp;#10;    ok = True&amp;#10;    streak = 1&amp;#10;    for j in range(1, 72):&amp;#10;        if labels[idx[j]] == labels[idx[j - 1]]:&amp;#10;            streak = streak + 1&amp;#10;        else:&amp;#10;            streak = 1&amp;#10;        if streak &gt; 3:&amp;#10;            ok = False&amp;#10;    if ok:&amp;#10;        break&amp;#10;&amp;#10;order = []&amp;#10;for j in range(72):&amp;#10;    order.append(idx[j])" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="let ok = false;&amp;#10;let streak = 1;&amp;#10;labels = [];&amp;#10;for (let i = 0; i &lt; 24; i++) { labels.push(&quot;TC&quot;); }&amp;#10;for (let i = 0; i &lt; 24; i++) { labels.push(&quot;NC&quot;); }&amp;#10;for (let i = 0; i &lt; 24; i++) { labels.push(&quot;FC&quot;); }&amp;#10;&amp;#10;idx = [];&amp;#10;for (let i = 0; i &lt; 72; i++) { idx.push(i); }&amp;#10;&amp;#10;for (let attempt = 0; attempt &lt; 1000; attempt++) {&amp;#10;    util.shuffle(idx);&amp;#10;    ok = true;&amp;#10;    streak = 1;&amp;#10;    for (let j = 1; j &lt; 72; j++) {&amp;#10;        if (labels[idx[j]] === labels[idx[j - 1]]) {&amp;#10;            streak = streak + 1;&amp;#10;        } else {&amp;#10;            streak = 1;&amp;#10;        }&amp;#10;        if (streak &gt; 3) { ok = false; }&amp;#10;    }&amp;#10;    if (ok) { break; }&amp;#10;}&amp;#10;&amp;#10;order = [];&amp;#10;for (let j = 0; j &lt; 72; j++) { order.push(idx[j]); }" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="positions = [[(- 0.35), 0.22], [0.35, 0.22], [(- 0.35), (- 0.25)], [0.35, (- 0.25)]];&amp;#10;util.shuffle(positions);&amp;#10;pos_target = positions[0];&amp;#10;pos_d1 = positions[1];&amp;#10;pos_d2 = positions[2];&amp;#10;pos_d3 = positions[3];&amp;#10;psychoJS.experiment.addData(&quot;target_pos&quot;, pos_target);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="positions = [[-0.35, 0.22], [0.35, 0.22], [-0.35, -0.25], [0.35, -0.25]]&amp;#10;shuffle(positions)&amp;#10;pos_target = positions[0]&amp;#10;pos_d1 = positions[1]&amp;#10;pos_d2 = positions[2]&amp;#10;pos_d3 = positions[3]&amp;#10;thisExp.addData('target_pos', pos_target)" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="if t &gt; 4.5 + audio_dur + 5:&amp;#10;    continueRoutine = False" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if ((t &gt; ((4.5 + audio_dur) + 5))) {&amp;#10;    continueRoutine = false;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="if ((mouse.clicked_name.length &gt; 0)) {&amp;#10;    resp = mouse.clicked_name.slice((- 1))[0];&amp;#10;} else {&amp;#10;    resp = &quot;timeout&quot;;&amp;#10;}&amp;#10;if ((resp === &quot;img_target&quot;)) {&amp;#10;    corr = 1;&amp;#10;} else {&amp;#10;    corr = 0;&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;response&quot;, resp);&amp;#10;psychoJS.experiment.addData(&quot;correct&quot;, corr);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="if len(mouse.clicked_name) &gt; 0:&amp;#10;    resp = mouse.clicked_name[-1]&amp;#10;else:&amp;#10;    resp = 'timeout'&amp;#10;if resp == 'img_target':&amp;#10;    corr = 1&amp;#10;else:&amp;#10;    corr = 0&amp;#10;thisExp.addData('response', resp)&amp;#10;thisExp.addData('correct', corr)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="pos_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
